{
    "name": "files-system",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/web",
        "apps/mobile",
        "apps/backend",
        "database",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "npm run dev --workspace=apps/web",
        "dev:mobile": "npm run start --workspace=apps/mobile",
        "build:web": "npm run build --workspace=apps/web",
        "lint:web": "npm run lint --workspace=apps/web"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "@prisma/engines@7.10.0": true,
        "esbuild@0.28.2": true,
        "prisma@7.10.0": true,
        "unrs-resolver@1.12.2": true
    }
}
